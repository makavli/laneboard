<Window x:Class="Laneboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laneboard" Width="420" Height="680" MinWidth="340" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="False"
        Icon="Assets/laneboard.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A quiet square button holding one icon glyph, like the ones in Windows' own flyouts. -->
    <Style x:Key="Icon" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <!-- The content is a glyph: a screen reader would read a private-use character, so it reads the tooltip. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A full-width clickable row (pull requests, the handoff note). -->
    <Style x:Key="Row" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,4">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,1,6,2"/>
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- The menu every project has on right click, Shift+F10 or the menu key. One instance serves every row,
         so it reads the project from the row it opened on. -->
    <ContextMenu x:Key="ProjectMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Open folder" Tag="folder" Click="OnAction"/>
      <MenuItem Header="Open in VS Code" Tag="code" Click="OnAction" Visibility="{Binding CanCode, Converter={StaticResource Vis}}"/>
      <MenuItem Header="Open terminal here" Tag="terminal" Click="OnAction"/>
      <MenuItem Header="Open on GitHub" Tag="github" Click="OnAction" Visibility="{Binding HasSlug, Converter={StaticResource Vis}}"/>
      <MenuItem Header="Open the handoff note" Tag="handoff" Click="OnAction" Visibility="{Binding HasHandoff, Converter={StaticResource Vis}}"/>
      <MenuItem Header="Copy path" Tag="copy" Click="OnAction"/>
      <Separator/>
      <MenuItem Header="{Binding PinLabel}" Tag="pin" Click="OnAction"/>
      <MenuItem Header="Hide this project" Tag="hide" Click="OnAction"/>
    </ContextMenu>

    <!-- A project in the list: arrow keys move between projects, Enter opens one, the menu key opens its menu.
         The ring shows only for the keyboard; the two views differ in spacing and corner. -->
    <Style x:Key="Item" TargetType="ListBoxItem">
      <Setter Property="ContextMenu" Value="{StaticResource ProjectMenu}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowItem" TargetType="ListBoxItem" BasedOn="{StaticResource Item}">
      <Setter Property="Margin" Value="8,0,8,2"/>
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="2" Stroke="{DynamicResource FocusStrokeColorOuterBrush}"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardItem" TargetType="ListBoxItem" BasedOn="{StaticResource Item}">
      <Setter Property="Margin" Value="12,0,12,10"/>
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style>
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" Stroke="{DynamicResource FocusStrokeColorOuterBrush}"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Open buttons: hidden until the pointer (or the keyboard) is on the project. -->
    <DataTemplate x:Key="Actions">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Icon}" Content="&#xE943;" Tag="code" ToolTip="Open in VS Code" Click="OnAction"
                Visibility="{Binding CanCode, Converter={StaticResource Vis}}"/>
        <Button Style="{StaticResource Icon}" Content="&#xE756;" Tag="terminal" ToolTip="Open terminal here" Click="OnAction"/>
        <Button Style="{StaticResource Icon}" Content="&#xE8B7;" Tag="folder" ToolTip="Open folder" Click="OnAction"/>
        <Button Style="{StaticResource Icon}" Content="&#xE774;" Tag="github" ToolTip="Open on GitHub" Click="OnAction"
                Visibility="{Binding HasSlug, Converter={StaticResource Vis}}"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WarningTemplate">
      <DockPanel Margin="0,3,0,0">
        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,2,8,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top"/>
        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PrTemplate">
      <Button Style="{StaticResource Row}" Tag="{Binding Url}" Click="OnOpenUrl" ToolTip="{Binding Tip}">
        <DockPanel>
          <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,1,10,0" VerticalAlignment="Center"
                   Fill="{DynamicResource SystemFillColorNeutralBrush}"/>
          <Border x:Name="DraftChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="6,0,0,0" Visibility="Collapsed">
            <TextBlock Text="draft" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </Border>
          <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="pass">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="fail">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="pending">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Draft}" Value="True">
          <Setter TargetName="DraftChip" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- LIGHT view: one airy row per project, the essentials only. -->
    <DataTemplate x:Key="RowTemplate">
      <Border x:Name="Bd" Padding="12,10,6,10" CornerRadius="6" Background="Transparent">
        <DockPanel>
          <Ellipse x:Name="Dot" Width="8" Height="8" Margin="2,0,12,0" VerticalAlignment="Center"
                   Fill="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.5"/>
          <StackPanel VerticalAlignment="Center">
            <DockPanel>
              <!-- On the name line, so the status line below keeps the full width. -->
              <ContentControl x:Name="Act" DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Actions}"
                              Opacity="0" Focusable="False" Margin="0,-7,0,-7" VerticalAlignment="Center"/>
              <TextBlock x:Name="Warn" DockPanel.Dock="Right" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12"
                         Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding WarningTip}"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}"
                         Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}"/>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" ToolTip="{Binding StatusTip}">
              <Run Text="{Binding Branch, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11"/><Run Text="  ·  "/><Run Text="{Binding LightLine, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
          <Setter TargetName="Act" Property="Opacity" Value="1"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Act" Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding WorstState}" Value="pass">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
          <Setter TargetName="Dot" Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding WorstState}" Value="pending">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
          <Setter TargetName="Dot" Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding WorstState}" Value="fail">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
          <Setter TargetName="Dot" Property="Opacity" Value="1"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ADVANCED view: the full card. -->
    <DataTemplate x:Key="CardTemplate">
      <Border x:Name="Bd" Style="{StaticResource Card}" Padding="16,12,8,12">
        <StackPanel>
          <DockPanel>
            <ContentControl x:Name="Act" DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Actions}"
                            Opacity="0" Focusable="False" Margin="4,-6,0,-4" VerticalAlignment="Top"/>
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Path}"/>
              <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                <TextBlock Text="{Binding Branch}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              </Border>
              <Border Style="{StaticResource Chip}" Visibility="{Binding IsPublic, Converter={StaticResource Vis}}">
                <TextBlock Text="public" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              </Border>
            </WrapPanel>
          </DockPanel>
          <TextBlock Text="{Binding StatusLine}" ToolTip="{Binding StatusTip}" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
          <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource WarningTemplate}" Margin="0,6,8,0"
                        Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}"/>
          <ItemsControl ItemsSource="{Binding Prs}" ItemTemplate="{StaticResource PrTemplate}" Margin="-6,8,8,0"
                        Visibility="{Binding HasPrs, Converter={StaticResource Vis}}"/>
          <TextBlock Text="{Binding MorePrs}" Style="{StaticResource Secondary}" Margin="11,0,0,0"
                     Visibility="{Binding HasMorePrs, Converter={StaticResource Vis}}"/>
          <Button Style="{StaticResource Row}" Tag="handoff" Click="OnAction" Margin="-6,8,8,0" ToolTip="Open the handoff note"
                  Visibility="{Binding HasHandoff, Converter={StaticResource Vis}}">
            <DockPanel>
              <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,2,10,2" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding HandoffMeta}" Style="{StaticResource Secondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <Border Style="{StaticResource Chip}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                          Visibility="{Binding SafePoint, Converter={StaticResource Vis}}">
                    <TextBlock Text="SAFE POINT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Handoff}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
          <Setter TargetName="Act" Property="Opacity" Value="1"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Act" Property="Opacity" Value="1"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Tint over the glass: the "opacity" setting, from see-through (0) to solid (100). -->
    <Border x:Name="Tint" Grid.RowSpan="3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0" IsHitTestVisible="False"/>

    <!-- Title bar: the window is dragged from here. -->
    <DockPanel Margin="16,0,10,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BackBtn" Style="{StaticResource Icon}" Content="&#xE72B;" ToolTip="Back" Click="OnBack" Visibility="Collapsed"/>
        <Button x:Name="ViewBtn" Style="{StaticResource Icon}" Content="&#xF0E2;" ToolTip="Advanced view" Click="OnToggleView"/>
        <Button x:Name="RefreshBtn" Style="{StaticResource Icon}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="OnRefresh"/>
        <Button x:Name="PinBtn" Style="{StaticResource Icon}" Content="&#xE718;" ToolTip="Keep open" Click="OnPin"/>
        <Button x:Name="SettingsBtn" Style="{StaticResource Icon}" Content="&#xE713;" ToolTip="Settings" Click="OnSettings"/>
        <Button Style="{StaticResource Icon}" Content="&#xE8BB;" FontSize="12" ToolTip="Close (Esc)" Click="OnClose"/>
      </StackPanel>
      <Image Source="Assets/laneboard.ico" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Laneboard" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock x:Name="UpdatedText" Style="{StaticResource Secondary}" FontSize="11" Text="Reading your projects…"/>
      </StackPanel>
    </DockPanel>

    <!-- Summary, chips, global warnings, filter. -->
    <StackPanel x:Name="TopPanel" Grid.Row="1" Margin="18,2,18,12">
      <TextBlock x:Name="SummaryText" Style="{StaticResource Secondary}"/>
      <WrapPanel x:Name="Chips" Margin="0,8,0,0">
        <Border x:Name="RunnerChip" Style="{StaticResource Chip}" Margin="0,0,6,4" Padding="8,3" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,1,6,0"/>
            <TextBlock x:Name="RunnerText" FontSize="11"/>
          </StackPanel>
        </Border>
        <Button x:Name="MinutesChip" Style="{StaticResource Row}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Margin="0,0,6,4" Cursor="Hand" Click="OnMinutesChip" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="2,-1">
            <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,1,6,0"/>
            <TextBlock x:Name="MinutesText" FontSize="11"/>
          </StackPanel>
        </Button>
        <Button x:Name="ScopeChip" Style="{StaticResource Row}" Margin="-6,-4,0,0" Click="OnSettings" Visibility="Collapsed"
                ToolTip="Laneboard can show this month's GitHub Actions minutes once the GitHub CLI may read your billing">
          <TextBlock Text="Show Actions minutes…" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        </Button>
      </WrapPanel>
      <ItemsControl x:Name="GlobalWarnings" ItemTemplate="{StaticResource WarningTemplate}" Margin="0,0,0,4"/>
      <Grid Margin="0,6,0,0">
        <TextBox x:Name="Search" TextChanged="OnSearch" Padding="30,6,8,6"
                 AutomationProperties.Name="Filter projects"/>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="SearchHint" Text="Filter projects" Margin="31,0,0,0" VerticalAlignment="Center" FontSize="13"
                   IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
      </Grid>
    </StackPanel>

    <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,0,10">
        <!-- A list (not a plain ItemsControl) for arrow keys, type-to-find and screen readers. No scroll viewer of its
             own: the outer one scrolls, and a nested one would swallow the mouse wheel. -->
        <ListBox x:Name="Cards" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource RowItem}"
                 TextSearch.TextPath="Name" KeyboardNavigation.TabNavigation="Continue"
                 AutomationProperties.Name="Projects">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter/>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="20,10,0,4"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </ListBox>
        <TextBlock x:Name="NoMatch" Text="No project matches." Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                   Margin="0,24,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <!-- First run: nothing to show yet. -->
    <StackPanel x:Name="Empty" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="40,0,40,60" Visibility="Collapsed">
      <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="40" HorizontalAlignment="Center"
                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
      <TextBlock Text="Where do you keep your projects?" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                 TextWrapping="Wrap" Margin="0,16,0,8"/>
      <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Pick a folder. Laneboard finds every Git repository in it and keeps an eye on them: changes, branches, pull requests, checks and handoff notes."/>
      <Button Content="Choose a folder" Margin="0,20,0,0" HorizontalAlignment="Center" Padding="20,6"
              Style="{DynamicResource AccentButtonStyle}" Click="OnAddFolder"/>
    </StackPanel>

    <!-- Settings page. -->
    <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,0,16,16">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource Section}"/>
            <TextBlock Text="Theme" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="System" Margin="0,0,16,0" Checked="OnTheme"/>
              <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Margin="0,0,16,0" Checked="OnTheme"/>
              <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="OnTheme"/>
            </StackPanel>
            <TextBlock Text="View" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ViewLight" GroupName="View" Content="Light: one row per project" Margin="0,0,16,0" Checked="OnView"/>
              <RadioButton x:Name="ViewAdvanced" GroupName="View" Content="Advanced: full cards" Checked="OnView"/>
            </StackPanel>
            <TextBlock Text="Window background" Style="{StaticResource Label}"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="Glass" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <TextBlock DockPanel.Dock="Right" Text="Solid" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="20" VerticalAlignment="Center"
                      ValueChanged="OnOpacity" AutomationProperties.Name="Window background, glass to solid"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Project folders" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Every Git repository in these folders, up to two levels down."/>
            <ItemsControl x:Name="FolderList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE711;" FontSize="11"
                            ToolTip="Remove" Tag="{Binding}" Click="OnRemoveFolder"/>
                    <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add a folder" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnAddFolder"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Behaviour" Style="{StaticResource Section}"/>
            <CheckBox x:Name="StartupBox" Content="Start with Windows (in the notification area)" Margin="0,6,0,0"
                      Checked="OnStartup" Unchecked="OnStartup"/>
            <CheckBox x:Name="PinBox" Content="Keep the window open when I click elsewhere" Margin="0,6,0,0"
                      Checked="OnPinBox" Unchecked="OnPinBox"/>
            <CheckBox x:Name="NotifyBox" Margin="0,6,0,0" Checked="OnNotifyBox" Unchecked="OnNotifyBox">
              <TextBlock TextWrapping="Wrap" Text="Notify me when checks fail or pass, a safe point is written, or a runner goes offline"/>
            </CheckBox>
            <DockPanel Margin="0,10,0,0">
              <ComboBox x:Name="IntervalBox" DockPanel.Dock="Right" MinWidth="120" SelectionChanged="OnInterval"
                        AutomationProperties.Name="Read GitHub every">
                <ComboBoxItem Content="2 minutes" Tag="2"/>
                <ComboBoxItem Content="5 minutes" Tag="5"/>
                <ComboBoxItem Content="15 minutes" Tag="15"/>
                <ComboBoxItem Content="30 minutes" Tag="30"/>
              </ComboBox>
              <TextBlock Text="Read GitHub every" VerticalAlignment="Center" TextWrapping="Wrap"
                         ToolTip="Pull requests, checks and runners. Every 2 minutes while checks run. Files on this PC update at once."/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="GitHub" Style="{StaticResource Section}"/>
            <TextBlock x:Name="GitHubStatus" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <StackPanel x:Name="ScopePanel" Visibility="Collapsed" Margin="0,8,0,0">
              <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="To see this month's Actions minutes, let the GitHub CLI read your billing once. Run this in a terminal, then refresh:"/>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Copy" Margin="6,0,0,0" Click="OnCopyScope"/>
                <TextBox x:Name="ScopeCommand" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Text="gh auth refresh -h github.com -s user"/>
              </DockPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Laneboard asks GitHub through your own GitHub CLI. It stores no token and sends nothing anywhere else."/>
          </StackPanel>
        </Border>

        <Border x:Name="HiddenCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Hidden projects" Style="{StaticResource Section}"/>
            <ItemsControl x:Name="HiddenList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Show" Padding="10,2" Tag="{Binding}" Click="OnUnhide"/>
                    <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock x:Name="AboutText" Style="{StaticResource Secondary}" Margin="4,8,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
